# =============================================================================
# DI-AAI-FS Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env — only .env.example is tracked.
# =============================================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=di_user
POSTGRES_PASSWORD=di_local_password
POSTGRES_DB=di_aai_fs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://di_user:di_local_password@localhost:5432/di_aai_fs

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (local dev uses filesystem) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads

# --- AI / LLM Provider ---
# Set your provider key. The adapter layer reads from here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Which model to use for the default AI tasks
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# --- Python API ---
PY_API_HOST=0.0.0.0
PY_API_PORT=8000
PY_API_LOG_LEVEL=info

# --- Next.js Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
